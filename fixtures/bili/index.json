    { "match": ["/x/player/wbi/v2", "BV1a0000003"], "file": "player-BV1a0000003.json" },
    { "match": ["/x/player/wbi/v2", "BV1a0000004"], "file": "player-BV1a0000004.json" },
    { "match": ["/x/player/wbi/v2", "BV1a0000005"], "file": "player-BV1a0000005.json" },
