{
  "name": "biliwhale",
  "version": "0.7.2",
  "private": true,
  "description": "常驻 Windows 的 B 站「养鱼」程序内核：有自己的作息，只调用 DeepSeek，零 Python、零 DSH 依赖",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none --test-concurrency=1 --test-force-exit \"test/*.test.ts\"",
    "run": "node src/cli.ts",
    "serve": "node src/cli.ts serve",
    "offline": "node src/cli.ts run --now --dry --fixtures --data-dir .run/offline",
    "prompt:lab": "node scripts/prompt-lab.mts",
    "live-read": "node src/cli.ts run --now --dry --mock-model --data-dir .run/live-read",
    "smoke:bili": "node scripts/smoke-bili.ts",
    "tray:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-tray.ps1",
    "doctor": "node src/cli.ts doctor",
    "pack": "node scripts/pack.mts",
    "pack:nozip": "node scripts/pack.mts --no-zip",
    "rehearse": "node scripts/rehearse.mts",
    "bench": "node scripts/bench.mts",
    "soak": "node scripts/soak.mts",
    "backup": "node src/cli.ts backup",
    "update:check": "node src/cli.ts update"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.8.0"
  }
}
